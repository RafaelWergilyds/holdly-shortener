PORT=3000

DATABASE_URL=postgres://holdly:4123@localhost:5432/holdly-db

REDIS_HOST=localhost
REDIS_PORT=6379

# At least 32 characters. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRATION=1d

# Salt for short codes. Set once and never change it: changing it breaks every existing short link.
HASHIDS_SALT=change-me
